{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "ravan-tun",
      "protocol": "tun",
      "settings": {
        "name": "ravan0",
        "MTU": 1500
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls"
        ]
      }
    }
  ],
  "outbounds": [
    {
      "tag": "ravan-socks",
      "protocol": "socks",
      "settings": {
        "servers": [
          {
            "address": "127.0.0.1",
            "port": 2080
          }
        ]
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom"
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "type": "field",
        "inboundTag": [
          "ravan-tun"
        ],
        "port": "53",
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "inboundTag": [
          "ravan-tun"
        ],
        "network": "udp",
        "outboundTag": "block"
      },
      {
        "type": "field",
        "inboundTag": [
          "ravan-tun"
        ],
        "network": "tcp",
        "outboundTag": "ravan-socks"
      }
    ]
  }
}
